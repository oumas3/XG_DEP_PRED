    "def entropy(p):\n",
    "    return -np.sum(p * np.log(p + 1e-9), axis=1)\n",
    "\n",
    "entropy_vals = entropy(probs.numpy())\n",
    "\n",
    "# Select top 30% most uncertain samples\n",
    "k = int(0.3 * len(entropy_vals))\n",
    "idx = np.argsort(entropy_vals)[-k:]\n",
    "\n",
    "X_refine = X[idx]\n",
    "y_refine = y[idx]\n",
    "\n",
    "print(f\"✅ Refinement dataset size: {X_refine.shape[0]}\")"
   ]
  },
