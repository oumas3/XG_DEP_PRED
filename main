   "source": [
    "def predict_with_refinement(text):\n",
    "    enc = tokenizer(text, return_tensors=\"pt\", truncation=True, padding=True).to(device)\n",
    "\n",
    "    with torch.no_grad():\n",
    "        # BASELINE PREDICTION (MentalBERT)\n",
    "        logits = model(**enc).logits\n",
    "        probs = torch.softmax(logits, dim=1).squeeze()\n",
    "\n",
    "        baseline_pred = torch.argmax(probs).item()\n",
    "\n",
    "        # FEATURE VECTOR\n",
    "        embed = base_model(**enc).last_hidden_state[:, 0, :].squeeze(0)\n",
    "        feat = torch.cat([embed, probs], dim=0).cpu().numpy().reshape(1, -1)\n",
    "\n",
    "        # UNCERTAINTY CHECK\n",
    "        ent = -np.sum(probs.cpu().numpy() * np.log(probs.cpu().numpy() + 1e-9))\n",
    "\n",
    "        refined_pred = baseline_pred\n",
    "\n",
    "        # APPLY XGBOOST ONLY IF UNCERTAIN\n",
    "        if ent > 1.2:\n",
    "            refined_pred = xgb_refiner.predict(feat)[0]\n",
    "\n",
    "        return baseline_pred, refined_pred"
   ]
  },
