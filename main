   "source": [
    "train_loader = DataLoader(train_dataset, batch_size=16)\n",
    "\n",
    "embeddings, probs_list, labels_list = [], [], []\n",
    "\n",
    "with torch.no_grad():\n",
    "    for batch in train_loader:\n",
    "        input_ids = batch[\"input_ids\"].to(device)\n",
    "        attention_mask = batch[\"attention_mask\"].to(device)\n",
    "\n",
    "        # CLS embeddings (semantic representation)\n",
    "        outputs_base = base_model(input_ids=input_ids,\n",
    "                                  attention_mask=attention_mask)\n",
    "        cls = outputs_base.last_hidden_state[:, 0, :]  # (batch, 768)\n",
    "\n",
    "        # classifier probabilities (uncertainty signal)\n",
    "        logits = model(input_ids=input_ids,\n",
    "                       attention_mask=attention_mask).logits\n",
    "        probs = torch.softmax(logits, dim=1)\n",
    "\n",
    "        embeddings.append(cls.cpu())\n",
    "        probs_list.append(probs.cpu())\n",
    "        labels_list.append(batch[\"label\"])\n",
    "\n",
    "# Concatenate all batches\n",
    "embeddings = torch.cat(embeddings)\n",
    "probs      = torch.cat(probs_list)\n",
    "labels_all = torch.cat(labels_list)\n",
    "\n",
    "# FINAL FEATURE SPACE (VERY IMPORTANT FOR XGBOOST)\n",
    "features = torch.cat([embeddings, probs], dim=1)\n",
    "\n",
    "print(\"✅ Feature extraction done:\", features.shape)"
   ]
  },
