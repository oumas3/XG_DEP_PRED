   "source": [
    "# PHASE 11 — Extract embeddings + probabilities (FOR REFINEMENT)\n",
    "\n",
    "from transformers import AutoModel\n",
    "\n",
    "base_model = AutoModel.from_pretrained(\"mental/mental-bert-base-uncased\")\n",
    "base_model.load_state_dict(torch.load(\"best_model.pt\"), strict=False)\n",
    "base_model = base_model.to(device)\n",
    "base_model.eval()\n",
    "\n",
    "print(\"Base model loaded for embeddings\")\n",
    "\n",
    "all_embeddings = []\n",
    "all_probs = []\n",
    "all_labels = []\n",
    "\n",
    "with torch.no_grad():\n",
    "    for batch in train_loader:\n",
    "        input_ids = batch[\"input_ids\"].to(device)\n",
    "        attention_mask = batch[\"attention_mask\"].to(device)\n",
    "        labels = batch[\"label\"]\n",
    "\n",
    "        # CLS embedding (semantic representation)\n",
    "        outputs = base_model(input_ids=input_ids, attention_mask=attention_mask)\n",
    "        cls = outputs.last_hidden_state[:, 0, :]   # shape: (batch, 768)\n",
    "\n",
    "        # Softmax probabilities (uncertainty signal)\n",
    "        logits = model(input_ids=input_ids, attention_mask=attention_mask).logits\n",
    "        probs = torch.softmax(logits, dim=1)\n",
    "\n",
    "        all_embeddings.append(cls.cpu())\n",
    "        all_probs.append(probs.cpu())\n",
    "        all_labels.append(labels)"
   ]
  },
