    "# PHASE 4 — Clean text\n",
    "import re\n",
    "\n",
    "def clean_text(text):\n",
    "    text = str(text)\n",
    "    text = re.sub(r\"http\\S+|www\\S+\", \"\", text)   # remove URLs\n",
    "    text = re.sub(r\"@\\w+\", \"\", text)              # remove mentions\n",
    "    text = re.sub(r\"r/\\w+\", \"\", text)             # remove subreddit refs\n",
    "    text = re.sub(r\"u/\\w+\", \"\", text)             # remove user refs\n",
    "    text = re.sub(r\"[^\\w\\s.,!?']\", \" \", text)     # keep basic punctuation\n",
    "    text = re.sub(r\"\\s+\", \" \", text)              # normalize spaces\n",
    "    return text.strip().lower()\n",
    "\n",
    "df[\"clean_text\"] = df[\"text\"].apply(clean_text)\n",
    "\n",
    "# Remove any empty texts after cleaning\n",
    "df = df[df[\"clean_text\"].apply(lambda x: len(x.strip()) > 3)].reset_index(drop=True)\n",
    "\n",
    "# Use the numeric label from now on\n",
    "df = df[[\"clean_text\", \"label_num\"]].rename(columns={\"label_num\": \"label\"})\n",
    "\n",
    "print(\"Cleaning done!\")\n",
    "print(f\"Final dataset size: {len(df)}\")\n",
    "print(\"\\nExample — BEFORE:\")\n",
    "print(df[\"clean_text\"][0][:200])\n",
    "print(\"\\nData ready for splitting.\")"
   ]
